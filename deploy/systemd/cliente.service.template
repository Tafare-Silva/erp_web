[Unit]
Description=Gunicorn daemon for __SLUG__
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/erp/app
EnvironmentFile=/var/www/clientes/__SLUG__/.env
ExecStart=/var/www/erp/venv/bin/gunicorn \
          --workers 2 \
          --bind unix:/var/www/clientes/__SLUG__/__SLUG__.sock \
          config.wsgi:application
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
