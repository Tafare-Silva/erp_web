SECRET_KEY=gerar-uma-chave-aleatoria-aqui
DEBUG=False

DB_NAME=erp_db
DB_USER=postgres
DB_PASSWORD=senha_forte_aqui
DB_HOST=localhost
DB_PORT=5432

ALLOWED_HOSTS=seudominio.com.br,www.seudominio.com.br
CSRF_TRUSTED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu_email@gmail.com
EMAIL_HOST_PASSWORD=sua_senha
EMAIL_USE_TLS=True

# --- Módulo de Veículos ---
# FIPE (grátis): URL base da API. Padrão já usa a API gratuita parallelum.
FIPE_API_URL=https://parallelum.com.br/fipe/api/v1

# Consulta de dados do veículo pela placa (APIBrasil - plano gratuito)
# Cadastre-se em https://app.apibrasil.io > Minhas APIs > Placa Dados para obter os tokens.
APIBRASIL_DEVICE_TOKEN=
APIBRASIL_BEARER_TOKEN=
# 1 = homologação (dados fictícios, não debita) | 0 = produção
APIBRASIL_HOMOLOG=1

# --- Deploy multi-cliente (systemd + gunicorn) ---
# Schema de busca do PostgreSQL. Deixe o padrão para o banco legado existente;
# use "public" para bancos novos criados do zero.
DB_SEARCH_PATH=cadastros,marilia,public

# Caminhos por cliente (cada cliente tem seu próprio diretório em /var/www/clientes/<slug>).
# Em desenvolvimento, deixe comentado para usar BASE_DIR/staticfiles e BASE_DIR/media.
# STATIC_ROOT=/var/www/clientes/cliente1/staticfiles
# MEDIA_ROOT=/var/www/clientes/cliente1/media

# Segurança em produção (DEBUG=False)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True